# Browser-visible basemap configuration. Leave empty to use the reference map.
VITE_TDT_KEY=

# Node HTTP server
HOST=127.0.0.1
PORT=8787

# Only the Node server may read these values. Use a long random publish token.
PUBLISH_MODE=local
PUBLISH_TOKEN=
# DATA_DIR=data/months

# Set for PUBLISH_MODE=github.
GITHUB_REPO=
GITHUB_BRANCH=
GITHUB_PUBLISH_TOKEN=

# Browser origin for split hosting, e.g. https://owner.github.io (no repo path).
APP_ORIGIN=
